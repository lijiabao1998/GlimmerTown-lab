  },
  "limits": [
    "Static original PNG review is not a runtime rerun or owner approval.",
    "Only24power originals visually reviewed; all other manifest entries checked by hash, not sight.",
    "FarLOD frames show ground markers, not detailed building silhouettes.",
    "Real mobile hardware, Safari, touch and temporal flicker not tested."
  ],
  "priorityFindings": [
    {
      "id": "pondbadminton",
      "subject": "Pondwick saddle roof",
      "result": "All four day preview rotations and all four full edge scenes retain a continuous saddle-like roof surface. The central low sweep and outer eaves show no obvious grass/sky slit, missing face, or detached wall."
    },
    {
      "id": "fennelhoney",
      "subject": "Fennel inner courtyard",
      "result": "The roof ring, inner-facing courtyard wall, and visible courtyard floor remain coherent through all four directions. No visible transparent wedge or missing inner wall was found."
    },
    {
      "id": "teaselhat",
      "subject": "Teasel wedge roof",
      "result": "The triangular roof footprint closes at both pointed corners and meets its brick elevations. Rotations r1 and r2 expose different wedge faces without an obvious open seam."
    },
    {
      "id": "rillramblers",
      "subject": "Rill spiral closure",
      "result": "The rising roof/wall sweep remains continuous. Its high end cap and lower entry end are visible in complementary directions, especially r0/r3, with no obvious missing end face. The open central court/entry is visually distinguishable from an accidental hole."
    },
    {
      "id": "gorsearchery",
      "subject": "Gorse canopy join",
      "result": "The broad canopy stays joined to the brick headhouse in all four directions. Its ridges and outer canopy edge do not show a visible background slit or floating roof panel."
    }
  ]
}
